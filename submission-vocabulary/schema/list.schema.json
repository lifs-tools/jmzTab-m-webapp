{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lifs-tools.org/submission-vocabulary/schema/list.schema.json",
  "title": "Submission vocabulary value list",
  "type": "object",
  "required": ["name", "entries"],
  "additionalProperties": false,
  "properties": {
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "entries": {"type": "array", "minItems": 1, "items": {"oneOf": [{"$ref": "#/$defs/term"}, {"$ref": "#/$defs/text"}]}}
  },
  "$defs": {
    "term": {
      "type": "object",
      "required": ["cv", "accession", "label"],
      "additionalProperties": false,
      "properties": {
        "cv": {"type": "string", "minLength": 1},
        "accession": {"type": "string", "pattern": "^[A-Za-z]+:[A-Za-z0-9_]+$"},
        "label": {"type": "string", "minLength": 1}
      }
    },
    "text": {
      "type": "object",
      "required": ["text"],
      "additionalProperties": false,
      "properties": {
        "text": {"type": "string", "minLength": 1},
        "note": {"type": "string"},
        "encoding": {
          "type": "object",
          "required": ["cv", "accession", "name", "value"],
          "additionalProperties": false,
          "properties": {
            "cv": {"type": "string"},
            "accession": {"type": "string"},
            "name": {"type": "string"},
            "value": {"type": "string"}
          }
        }
      }
    }
  }
}
