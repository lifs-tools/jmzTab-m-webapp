{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lifs-tools.org/submission-vocabulary/schema/mapping.schema.json",
  "title": "Submission vocabulary mapping",
  "description": "A mapping file. The forms and rules are defined in mapping-language.md, which is normative.",
  "type": "object",
  "required": ["id", "version", "kind", "vocabulary"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]*$"},
    "version": {"$ref": "#/$defs/semver"},
    "kind": {"enum": ["input", "output"]},
    "vocabulary": {"$ref": "#/$defs/semver"},
    "target": {"type": "string", "minLength": 1},
    "parameters": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/name"}},
    "cvs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["full-name", "version", "uri"],
        "additionalProperties": false,
        "properties": {
          "full-name": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "uri": {"type": "string", "minLength": 1}
        }
      }
    },
    "let": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/letName"},
      "additionalProperties": {"$ref": "#/$defs/expr"}
    },
    "metadata": {"type": "array", "items": {"$ref": "#/$defs/metadataRule"}},
    "tables": {"type": "array", "items": {"$ref": "#/$defs/table"}},
    "sheets": {"type": "array", "items": {"$ref": "#/$defs/sheet"}}
  },
  "allOf": [
    {
      "if": {"properties": {"kind": {"const": "output"}}, "required": ["kind"]},
      "then": {"required": ["target"], "properties": {"sheets": false}}
    },
    {
      "if": {"properties": {"kind": {"const": "input"}}, "required": ["kind"]},
      "then": {"properties": {"target": false, "metadata": false, "tables": false}}
    }
  ],
  "$defs": {
    "semver": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "letName": {
      "description": "A let name never shadows: it is not params, a top-level key of the vocabulary instance, or a vocabulary group id.",
      "allOf": [{"$ref": "#/$defs/name"}],
      "not": {"enum": ["params", "template", "study", "contacts", "datasets", "samples", "factors", "lipids", "quantities", "runs", "issues"]}
    },
    "sheet": {
      "description": "A sheet an input mapping reads: by its name, or named by the value of a field, one sheet per record of that field's group.",
      "type": "object",
      "required": ["group", "layout"],
      "additionalProperties": false,
      "oneOf": [{"required": ["sheet"]}, {"required": ["named-by"]}],
      "properties": {
        "sheet": {"type": "string", "minLength": 1},
        "named-by": {"type": "string", "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"},
        "group": {"$ref": "#/$defs/name"},
        "layout": {"$ref": "#/$defs/name"},
        "columns": {
          "type": "object",
          "propertyNames": {"minLength": 1},
          "additionalProperties": {"$ref": "#/$defs/name"}
        },
        "factor-columns": {"$ref": "#/$defs/name"}
      }
    },
    "variable": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$", "not": {"const": "params"}},
    "metadataRule": {
      "if": {"type": "object", "required": ["each"]},
      "then": {"$ref": "#/$defs/each"},
      "else": {"$ref": "#/$defs/line"}
    },
    "line": {
      "type": "object",
      "required": ["key", "value"],
      "additionalProperties": false,
      "properties": {
        "key": {"type": "string", "minLength": 1},
        "value": {"$ref": "#/$defs/expr"}
      }
    },
    "each": {
      "type": "object",
      "required": ["each", "as", "lines"],
      "additionalProperties": false,
      "properties": {
        "each": {"$ref": "#/$defs/expr"},
        "as": {"$ref": "#/$defs/variable"},
        "where": {"$ref": "#/$defs/expr"},
        "lines": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/metadataRule"}}
      }
    },
    "table": {
      "type": "object",
      "required": ["section", "header", "rows", "as", "columns"],
      "additionalProperties": false,
      "properties": {
        "section": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "header": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "rows": {"$ref": "#/$defs/expr"},
        "as": {"$ref": "#/$defs/variable"},
        "columns": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/columnRule"}}
      }
    },
    "columnRule": {
      "if": {"type": "object", "required": ["each"]},
      "then": {
        "type": "object",
        "required": ["each", "as", "columns"],
        "additionalProperties": false,
        "properties": {
          "each": {"$ref": "#/$defs/expr"},
          "as": {"$ref": "#/$defs/variable"},
          "columns": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/column"}}
        }
      },
      "else": {"$ref": "#/$defs/column"}
    },
    "column": {
      "type": "object",
      "required": ["header", "value"],
      "additionalProperties": false,
      "properties": {
        "header": {"type": "string", "minLength": 1},
        "value": {"$ref": "#/$defs/expr"},
        "where": {"$ref": "#/$defs/expr"}
      }
    },
    "exprs": {"type": "array", "items": {"$ref": "#/$defs/expr"}},
    "expr": {
      "description": "An expression: an object with exactly one key, the form.",
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": false,
      "properties": {
        "literal": {},
        "field": {"type": "string", "pattern": "^[^.]+(\\.[^.]+)*$"},
        "ref": {"$ref": "#/$defs/name"},
        "pos": {"$ref": "#/$defs/variable"},
        "format": {
          "type": "object", "required": ["template"], "additionalProperties": false,
          "properties": {"template": {"type": "string"}, "args": {"$ref": "#/$defs/exprs"}}
        },
        "join": {
          "type": "object", "required": ["items", "sep"], "additionalProperties": false,
          "properties": {
            "items": {"anyOf": [{"$ref": "#/$defs/exprs"}, {"$ref": "#/$defs/expr"}]},
            "sep": {"type": "string"}
          }
        },
        "first": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/expr"}},
        "split": {
          "type": "object", "required": ["value", "sep"], "additionalProperties": false,
          "properties": {"value": {"$ref": "#/$defs/expr"}, "sep": {"type": "string", "minLength": 1}}
        },
        "when": {
          "type": "object", "required": ["if", "then"], "additionalProperties": false,
          "properties": {"if": {"$ref": "#/$defs/expr"}, "then": {"$ref": "#/$defs/expr"}, "else": {"$ref": "#/$defs/expr"}}
        },
        "eq": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/expr"}},
        "lower": {"$ref": "#/$defs/expr"},
        "not-empty": {"$ref": "#/$defs/expr"},
        "count": {"$ref": "#/$defs/expr"},
        "at": {
          "type": "object", "required": ["list", "index"], "additionalProperties": false,
          "properties": {"list": {"$ref": "#/$defs/expr"}, "index": {"$ref": "#/$defs/expr"}}
        },
        "concat": {"$ref": "#/$defs/exprs"},
        "entries": {"$ref": "#/$defs/expr"},
        "map": {
          "type": "object", "required": ["over", "as", "value"], "additionalProperties": false,
          "properties": {"over": {"$ref": "#/$defs/expr"}, "as": {"$ref": "#/$defs/variable"}, "value": {"$ref": "#/$defs/expr"}}
        },
        "find": {"$ref": "#/$defs/search"},
        "filter": {"$ref": "#/$defs/search"},
        "term": {
          "type": "object", "required": ["value"], "additionalProperties": false,
          "properties": {"value": {"$ref": "#/$defs/expr"}, "param-value": {"$ref": "#/$defs/expr"}}
        },
        "cvparam": {
          "type": "object", "required": ["cv", "accession", "name"], "additionalProperties": false,
          "properties": {
            "cv": {"$ref": "#/$defs/expr"}, "accession": {"$ref": "#/$defs/expr"},
            "name": {"$ref": "#/$defs/expr"}, "value": {"$ref": "#/$defs/expr"}
          }
        },
        "user-param": {
          "type": "object", "required": ["name"], "additionalProperties": false,
          "properties": {"name": {"$ref": "#/$defs/expr"}, "value": {"$ref": "#/$defs/expr"}}
        },
        "label": {"$ref": "#/$defs/expr"},
        "number": {"$ref": "#/$defs/expr"},
        "normalise": {
          "type": "object", "required": ["kind", "value"], "additionalProperties": false,
          "properties": {"kind": {"enum": ["doi", "email"]}, "value": {"$ref": "#/$defs/expr"}}
        },
        "match": {
          "type": "object", "required": ["value", "regex", "group"], "additionalProperties": false,
          "properties": {
            "value": {"$ref": "#/$defs/expr"},
            "regex": {"type": "string", "minLength": 1},
            "group": {"type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9]*$"}
          }
        },
        "convert-unit": {
          "type": "object", "required": ["value", "from", "to"], "additionalProperties": false,
          "properties": {"value": {"$ref": "#/$defs/expr"}, "from": {"$ref": "#/$defs/expr"}, "to": {"$ref": "#/$defs/expr"}}
        },
        "aggregate": {
          "type": "object", "required": ["fn", "values"], "additionalProperties": false,
          "properties": {"fn": {"enum": ["mean", "cv"]}, "values": {"$ref": "#/$defs/expr"}}
        },
        "ref-to": {
          "type": "object", "required": ["element", "name"], "additionalProperties": false,
          "properties": {"element": {"type": "string", "pattern": "^[a-z][a-z_]*$"}, "name": {"$ref": "#/$defs/expr"}}
        },
        "fn": {
          "type": "object", "required": ["name"], "additionalProperties": false,
          "properties": {
            "name": {"enum": ["goslin-parse", "factor-combinations", "formula-check", "index-allocate"]},
            "args": {"$ref": "#/$defs/exprs"}
          }
        }
      }
    },
    "search": {
      "type": "object", "required": ["in", "as", "where"], "additionalProperties": false,
      "properties": {"in": {"$ref": "#/$defs/expr"}, "as": {"$ref": "#/$defs/variable"}, "where": {"$ref": "#/$defs/expr"}}
    }
  }
}
